<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_blockbee" model="payment.provider">
        <field name="code">blockbee</field>
        <field name="name">BlockBee Payment Gateway</field>
        <field name="is_published">True</field>
        <field name="image_128" type="base64" file="payment_blockbee/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_blockbee"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment_blockbee.payment_method_blockbee'),
                    ])]"
        />
    </record>

</odoo>
